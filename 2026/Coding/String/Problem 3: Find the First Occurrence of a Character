String str = "banana";
char target = 'a';


public class Main {
    public static void main(String[] args) {
        String str = "banana";
        char target = 'a';

        int index = -1;

        for (int i = 0; i < str.length(); i++) {
            if (str.charAt(i) == target) {
                index = i;
                break;
            }
        }

        System.out.println(index);
    }
}
//Remember: -1 means the character was not found.
